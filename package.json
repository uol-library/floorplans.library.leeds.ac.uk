{
  "name": "floorplans",
  "version": "0.0.1",
  "description": "University of Leeds Library floorplans",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "buildStatic": "node _scripts/writeFeatureMaps.js && node _scripts/writeIcons.js",
    "buildProd": "JEKYLL_ENV=production bundle exec jekyll build --config _config.yml,_config_prod.yml",
    "buildDev": "JEKYLL_ENV=development bundle exec jekyll build --config _config.yml,_config-dev.yml",
    "build": "npm run buildStatic && npm run buildProd && npm run buildDev",
    "buildImages": "node _scripts/compressPNG.js",
    "makeManifests": "node _scripts/makeManifests.js",
    "geo": "node _scripts/georeferenceFeatures.mjs",
    "serve": "bundle exec jekyll serve --config _config.yml,_config-dev.yml,_config-local.yml",
    "serveprod": "bundle exec jekyll serve --config _config.yml,_config_prod.yml,_config-local.yml",
    "servepages": "bundle exec jekyll serve --config _config.yml,_config-local.yml"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uol-library/floorplans.git"
  },
  "author": "Peter Edwards <p.l.edwards@leeds.ac.uk>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/uol-library/floorplans/issues"
  },
  "homepage": "https://github.com/uol-library/floorplans",
  "devDependencies": {
    "@allmaps/transform": "^1.0.0-beta.48",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.2.5",
    "sharp": "^0.35.4",
    "uglify-js": "^3.17.4"
  }
}
